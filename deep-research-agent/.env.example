OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
TAVILY_MAX_RESULTS=3
INTERVIEW_MAX_TURNS=2
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research
CHECKPOINT_DATABASE_URL=postgresql://research:research@localhost:5432/research
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=900
WORKER_HEARTBEAT_SECONDS=15
MAX_WORKER_ATTEMPTS=3
# Optional JSON list of origins
CORS_ORIGINS=[]

# Required for all non-health endpoints; generate a long random value
API_KEY=replace-with-long-random-key
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-assistant
PROMPT_VERSION=v1
ENFORCE_REPORT_SOURCES=true
